# PostgreSQL (Supabase) connection string — use the Session Pooler URL
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"

# Admin auth
JWT_SECRET="change-me-to-a-random-64-char-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
STAFF_EMAIL=""
STAFF_PASSWORD=""

# Store
STORE_NAME="Ranmuthu Fancy"
STORE_CURRENCY="LKR"

# WhatsApp order notifications
WHATSAPP_ADMIN_NUMBER="+94779560026"
# Optional WhatsApp Cloud API
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
